# Copy to .env.submit (gitignored). Values come from `pnpm wxt submit init` or the GitHub Actions secrets.
CHROME_API_VERSION=v2
CHROME_CANCEL_PENDING=true
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
# Paste the JSON `private_key` value in double quotes, keeping the \n sequences (pre-commit rejects a real PEM here)
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=""
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
